{
  "info": {
    "name": "EcommerceAPI",
    "description": "Colección de endpoints para Categories, Products y Sales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "categories" ]
            }
          }
        },
        {
          "name": "Get Category By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/1",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "categories", "1" ]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Category\",\n  \"description\": \"Category description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "categories" ]
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Category Name\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories/1",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "categories", "1" ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get Products (paginated + filters + sort)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?pageNumber=1&pageSize=10&name=&categoryId=&minPrice=&maxPrice=&inStock=&sortBy=Id&descending=false",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "products" ],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "name",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "categoryId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "minPrice",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "maxPrice",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "inStock",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "Id"
                },
                {
                  "key": "descending",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "products", "1" ]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Product\",\n  \"description\": \"Product description\",\n  \"price\": 25.00,\n  \"stock\": 10,\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "products" ]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Product Name\",\n  \"description\": null,\n  \"price\": 30.00,\n  \"stock\": null,\n  \"categoryId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "products", "1" ]
            }
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Get Sales (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sales?pageNumber=1&pageSize=10",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "sales" ],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Sale By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sales/1",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "sales", "1" ]
            }
          }
        },
        {
          "name": "Create Sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"products\": [\n    { \"productId\": 1, \"quantity\": 2 },\n    { \"productId\": 5, \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "sales" ]
            }
          }
        },
        {
          "name": "Update Sale Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Cancelled\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales/1",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "sales", "1" ]
            }
          }
        }
      ]
    }
  ]
}